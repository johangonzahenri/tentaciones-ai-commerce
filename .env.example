# Tentaciones AI Commerce — Environment Configuration Template
# (Zero real secrets in version control)

# Port for local Storefront server
PORT=4000

# Parent Platform API Connection
PLATFORM_API_BASE_URL=http://127.0.0.1:3000/api/v1
PLATFORM_APPLICATION_ID=tentaciones-commerce
PLATFORM_TENANT_ID=tenant-tentaciones

# Application Environment Mode (LOCAL / LIVE)
APP_ENV=LOCAL
DEFAULT_CURRENCY=CLP
FREE_SHIPPING_THRESHOLD_CLP=30000
